{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/generation-results-proposal.schema.json",
  "title": "Generation Results Proposal",
  "description": "Local inventory and comparison packet binding approved generation-plan inputs to a fresh direct-child result pack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_required", "plan_path", "plan_sha256", "plan_review_path", "plan_review_sha256", "template_path", "template_sha256", "template_id", "request_path", "request_sha256", "reference_pack", "reference_inventory_sha256", "result_pack", "scanner_policy_version", "result_inventory", "result_inventory_sha256", "tasks", "evidence"],
  "properties": {
    "schema_version": {"const": "0.6.0"},
    "review_required": {"const": true},
    "plan_path": {"$ref": "#/$defs/relativePath"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "plan_review_path": {"$ref": "#/$defs/relativePath"},
    "plan_review_sha256": {"$ref": "#/$defs/sha256"},
    "template_path": {"$ref": "#/$defs/relativePath"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "template_id": {"$ref": "#/$defs/slotId"},
    "request_path": {"$ref": "#/$defs/relativePath"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "reference_pack": {"$ref": "#/$defs/directChildName"},
    "reference_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "result_pack": {"$ref": "#/$defs/directChildName"},
    "scanner_policy_version": {"const": "0.5.0"},
    "result_inventory": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/inventoryEntry"}},
    "result_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/task"}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["comparison_contact_sheet"], "properties": {"comparison_contact_sheet": {"$ref": "#/$defs/artifact"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512},
    "directChildName": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/:\\\\]*[^/:\\\\. ]$"},
    "slotId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "assetId": {"type": "string", "pattern": "^asset\\.[0-9]{4}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "imageFacts": {"type": "object", "additionalProperties": false, "required": ["kind", "width", "height", "pixels"], "properties": {"kind": {"const": "image"}, "width": {"type": "integer", "minimum": 1, "maximum": 16384}, "height": {"type": "integer", "minimum": 1, "maximum": 16384}, "pixels": {"type": "integer", "minimum": 1, "maximum": 100000000}}},
    "inventoryEntry": {"type": "object", "additionalProperties": false, "required": ["asset_id", "source_path", "sha256", "size_bytes", "media_type", "facts"], "properties": {"asset_id": {"$ref": "#/$defs/assetId"}, "source_path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456}, "media_type": {"enum": ["image/jpeg", "image/png", "image/webp"]}, "facts": {"$ref": "#/$defs/imageFacts"}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["role", "asset_id"], "properties": {"role": {"enum": ["identity", "garment", "product", "background", "reference", "audio"]}, "asset_id": {"$ref": "#/$defs/assetId"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "target_slot_id", "required", "kind", "passthrough", "omit", "references", "result_asset_id"], "properties": {"task_id": {"type": "string", "pattern": "^task\\.[0-9]{4}$"}, "target_slot_id": {"$ref": "#/$defs/slotId"}, "required": {"type": "boolean"}, "kind": {"enum": ["identity-try-on", "product-still", "background-still", "reference-guided-still"]}, "passthrough": {"type": "boolean"}, "omit": {"type": "boolean"}, "references": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/reference"}}, "result_asset_id": {"type": ["string", "null"], "pattern": "^asset\\.[0-9]{4}$"}}}
  }
}
