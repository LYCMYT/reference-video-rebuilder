{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/higgsfield-web-handoff-request.schema.json",
  "title": "Higgsfield Web Motion-Control Handoff Request",
  "description": "Private, local-only preparation record for one user-operated Higgsfield web upload. It is neither a provider request nor a provider attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "surface", "model", "resolution", "output_id", "character_slot_id", "motion_mode", "audio_mode", "lip_sync_requested", "clone_authorized_voice_requested", "max_credits", "cloud_upload_confirmed", "prompt", "upload_authorizations"],
  "properties": {
    "schema_version": {"const": "0.10.1"},
    "provider_id": {"const": "higgsfield-web"},
    "surface": {"const": "motion-control"},
    "model": {"const": "kling-3.0-motion-control"},
    "resolution": {"const": "720p"},
    "output_id": {"$ref": "#/$defs/id"},
    "character_slot_id": {"$ref": "#/$defs/id"},
    "motion_mode": {"enum": ["pose-transfer", "video-to-video"]},
    "audio_mode": {"enum": ["mute", "preserve-reference"]},
    "lip_sync_requested": {"const": false},
    "clone_authorized_voice_requested": {"const": false},
    "max_credits": {"type": "integer", "minimum": 1, "maximum": 100000},
    "cloud_upload_confirmed": {"const": true},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
    "upload_authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_image", "motion_reference"],
      "properties": {
        "character_image": {"$ref": "#/$defs/characterAuthorization"},
        "motion_reference": {"$ref": "#/$defs/motionAuthorization"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "minLength": 20, "maxLength": 40, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "characterAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_slot_id", "source_sha256", "provider_id", "purpose", "output_id", "expires_at", "rights_confirmed", "cloud_upload_confirmed"],
      "properties": {
        "source_slot_id": {"$ref": "#/$defs/id"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "provider_id": {"const": "higgsfield-web"},
        "purpose": {"const": "motion-control"},
        "output_id": {"$ref": "#/$defs/id"},
        "expires_at": {"$ref": "#/$defs/utc"},
        "rights_confirmed": {"const": true},
        "cloud_upload_confirmed": {"const": true}
      }
    },
    "motionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "provider_id", "purpose", "output_id", "expires_at", "rights_confirmed", "cloud_upload_confirmed"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "provider_id": {"const": "higgsfield-web"},
        "purpose": {"const": "motion-control"},
        "output_id": {"$ref": "#/$defs/id"},
        "expires_at": {"$ref": "#/$defs/utc"},
        "rights_confirmed": {"const": true},
        "cloud_upload_confirmed": {"const": true}
      }
    }
  }
}
