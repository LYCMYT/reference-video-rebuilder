{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/temporal-delivery-report.schema.json",
  "title": "Temporal Delivery Report",
  "description": "Frozen byte-copy delivery record for a fully human-reviewed temporal replacement. It explicitly makes no bitstream-faithful claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "completion", "review_required", "bitstream_faithful", "provider_provenance", "plan_path", "plan_sha256", "plan_review_path", "plan_review_sha256", "proposal_path", "proposal_sha256", "results_review_path", "results_review_sha256", "template_path", "template_sha256", "template_id", "manifest_path", "manifest_sha256", "request_path", "request_sha256", "input_assets_sha256", "reference_pack", "reference_inventory_sha256", "result_pack", "result_inventory_sha256", "requirements_sha256", "final_video", "media", "technical_sanity", "verified"],
  "properties": {
    "schema_version": {"const": "0.10.0"}, "completion": {"const": "temporal_replacement_reviewed"}, "review_required": {"const": false}, "bitstream_faithful": {"const": false}, "provider_provenance": {"const": "unattested-local-file-drop"},
    "plan_path": {"$ref": "#/$defs/relativePath"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "plan_review_path": {"$ref": "#/$defs/relativePath"}, "plan_review_sha256": {"$ref": "#/$defs/sha256"}, "proposal_path": {"$ref": "#/$defs/relativePath"}, "proposal_sha256": {"$ref": "#/$defs/sha256"}, "results_review_path": {"$ref": "#/$defs/relativePath"}, "results_review_sha256": {"$ref": "#/$defs/sha256"},
    "template_path": {"$ref": "#/$defs/relativePath"}, "template_sha256": {"$ref": "#/$defs/sha256"}, "template_id": {"$ref": "#/$defs/id"}, "manifest_path": {"$ref": "#/$defs/relativePath"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "request_path": {"$ref": "#/$defs/relativePath"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "input_assets_sha256": {"$ref": "#/$defs/sha256"},
    "reference_pack": {"$ref": "#/$defs/directChildName"}, "reference_inventory_sha256": {"$ref": "#/$defs/sha256"}, "result_pack": {"$ref": "#/$defs/directChildName"}, "result_inventory_sha256": {"$ref": "#/$defs/sha256"}, "requirements_sha256": {"$ref": "#/$defs/sha256"}, "final_video": {"$ref": "#/$defs/artifact"}, "media": {"$ref": "#/$defs/mediaFacts"}, "technical_sanity": {"$ref": "#/$defs/technicalSanity"}, "verified": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "relativePath": {"type": "string", "minLength": 1, "maxLength": 512}, "directChildName": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/:\\\\]*[^/:\\\\. ]$"}, "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "mediaFacts": {"type": "object", "additionalProperties": false, "required": ["container", "width", "height", "fps", "frame_count", "duration_seconds", "cfr", "video_codec", "video_profile", "pixel_format", "bit_depth", "has_audio", "audio_stream_count", "audio_codec", "audio_profile", "audio_sample_rate", "audio_channels", "audio_channel_layout", "rotation_degrees"], "properties": {"container": {"const": "mp4"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "exclusiveMinimum": 0}, "frame_count": {"type": "integer", "minimum": 1}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}, "cfr": {"const": true}, "video_codec": {"const": "h264"}, "video_profile": {"const": "High"}, "pixel_format": {"const": "yuv420p"}, "bit_depth": {"const": 8}, "has_audio": {"type": "boolean"}, "audio_stream_count": {"enum": [0, 1]}, "audio_codec": {"type": ["string", "null"]}, "audio_profile": {"type": ["string", "null"]}, "audio_sample_rate": {"type": ["integer", "null"]}, "audio_channels": {"type": ["integer", "null"]}, "audio_channel_layout": {"type": ["string", "null"]}, "rotation_degrees": {"const": 0}}, "allOf": [{"if": {"properties": {"has_audio": {"const": true}}, "required": ["has_audio"]}, "then": {"properties": {"audio_stream_count": {"const": 1}, "audio_codec": {"const": "aac"}, "audio_profile": {"const": "LC"}, "audio_sample_rate": {"const": 48000}, "audio_channels": {"const": 2}, "audio_channel_layout": {"const": "stereo"}}}}, {"if": {"properties": {"has_audio": {"const": false}}, "required": ["has_audio"]}, "then": {"properties": {"audio_stream_count": {"const": 0}, "audio_codec": {"const": null}, "audio_profile": {"const": null}, "audio_sample_rate": {"const": null}, "audio_channels": {"const": null}, "audio_channel_layout": {"const": null}}}}]},
    "technicalSanity": {"type": "object", "additionalProperties": false, "required": ["schema_version", "semantic_action_not_proven", "limitations", "result", "reference"], "properties": {"schema_version": {"const": "0.10.0"}, "semantic_action_not_proven": {"const": true}, "limitations": {"const": "Technical temporal metrics are negative checks only and do not prove semantic action or motion reproduction."}, "reference": {"$ref": "#/$defs/sanityMetrics"}, "result": {"$ref": "#/$defs/sanityMetrics"}}},
    "sanityMetrics": {"type": "object", "additionalProperties": false, "required": ["sampled_frames", "adjacent_pairs", "repeated_adjacent_pairs", "static_adjacent_pairs", "black_frames", "mean_frame_difference", "max_freeze_run", "extreme_freeze_detected"], "properties": {"sampled_frames": {"type": "integer", "minimum": 1}, "adjacent_pairs": {"type": "integer", "minimum": 0}, "repeated_adjacent_pairs": {"type": "integer", "minimum": 0}, "static_adjacent_pairs": {"type": "integer", "minimum": 0}, "black_frames": {"type": "integer", "minimum": 0}, "mean_frame_difference": {"type": "number", "minimum": 0}, "max_freeze_run": {"type": "integer", "minimum": 1}, "extreme_freeze_detected": {"type": "boolean"}}}
  }
}
