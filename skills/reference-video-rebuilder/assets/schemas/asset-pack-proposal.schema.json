{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/asset-pack-proposal.schema.json",
  "title": "Local Asset Pack Proposal",
  "description": "Strict, local-only inventory and exact-name slot-candidate packet for asset pack workflow 0.5.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "privacy_profile",
    "analysis_rights_confirmed",
    "review_required",
    "template_path",
    "template_sha256",
    "template_id",
    "asset_pack",
    "scanner_policy_version",
    "inventory",
    "inventory_sha256",
    "slot_candidates",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "privacy_profile": {"const": "local-only"},
    "analysis_rights_confirmed": {"const": true},
    "review_required": {"const": true},
    "template_path": {"$ref": "#/$defs/relativePath"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "template_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "asset_pack": {"$ref": "#/$defs/directChildName"},
    "scanner_policy_version": {"const": "0.5.0"},
    "inventory": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/inventoryEntry"}
    },
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "slot_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/slotCandidate"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_contact_sheet"],
      "properties": {
        "asset_contact_sheet": {"$ref": "#/$defs/artifact"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512},
    "directChildName": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/:\\\\]*[^/:\\\\. ]$"},
    "inventoryMediaType": {
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "audio/wav",
        "audio/mpeg",
        "audio/mp4",
        "audio/x-matroska"
      ]
    },
    "declaredMediaType": {
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "video/mp4",
        "video/quicktime",
        "video/webm",
        "audio/wav",
        "audio/mpeg",
        "audio/mp4",
        "audio/x-matroska"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "imageFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width", "height", "pixels"],
      "properties": {
        "kind": {"const": "image"},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "pixels": {"type": "integer", "minimum": 1, "maximum": 100000000}
      }
    },
    "audioFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "duration_seconds", "audio_stream_count", "video_stream_count"],
      "properties": {
        "kind": {"const": "audio"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "audio_stream_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "video_stream_count": {"const": 0}
      }
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "source_path", "sha256", "size_bytes", "media_type", "facts"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset\\.[0-9]{4}$"},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "media_type": {"$ref": "#/$defs/inventoryMediaType"},
        "facts": {"oneOf": [{"$ref": "#/$defs/imageFacts"}, {"$ref": "#/$defs/audioFacts"}]}
      }
    },
    "slotCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "required",
        "type",
        "accepted_media",
        "representation_requirement",
        "status",
        "candidate_asset_ids"
      ],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "required": {"type": "boolean"},
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "accepted_media": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/declaredMediaType"}},
        "representation_requirement": {"enum": ["raw", "render-ready"]},
        "status": {"enum": ["missing", "incompatible", "suggested", "ambiguous"]},
        "candidate_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^asset\\.[0-9]{4}$"}}
      }
    }
  }
}
