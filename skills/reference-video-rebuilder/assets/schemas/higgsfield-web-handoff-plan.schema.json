{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/higgsfield-web-handoff-plan.schema.json",
  "title": "Higgsfield Web Motion-Control Handoff Plan",
  "description": "Local review plan and exact upload inventory for one user-operated web handoff. It binds the complete private Request hash without exposing the prompt or a separately guessable prompt digest, and it does not prove submission, provider behavior, or provider output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "surface", "model", "resolution", "temporal_plan_path", "temporal_plan_sha256", "temporal_plan_review_path", "temporal_plan_review_sha256", "handoff_request_path", "handoff_request_sha256", "template_id", "template_path", "template_sha256", "manifest_path", "manifest_sha256", "reference_pack", "reference_inventory_sha256", "output", "requirements", "cloud_reauthorization", "upload_pack", "upload_inventory", "upload_inventory_sha256", "provider_provenance"],
  "properties": {
    "schema_version": {"const": "0.10.1"},
    "provider_id": {"const": "higgsfield-web"},
    "surface": {"const": "motion-control"},
    "model": {"const": "kling-3.0-motion-control"},
    "resolution": {"const": "720p"},
    "temporal_plan_path": {"$ref": "#/$defs/relativePath"},
    "temporal_plan_sha256": {"$ref": "#/$defs/sha256"},
    "temporal_plan_review_path": {"$ref": "#/$defs/relativePath"},
    "temporal_plan_review_sha256": {"$ref": "#/$defs/sha256"},
    "handoff_request_path": {"$ref": "#/$defs/relativePath"},
    "handoff_request_sha256": {"$ref": "#/$defs/sha256"},
    "template_id": {"$ref": "#/$defs/id"},
    "template_path": {"$ref": "#/$defs/relativePath"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_path": {"$ref": "#/$defs/relativePath"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reference_pack": {"$ref": "#/$defs/directChild"},
    "reference_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "output": {"$ref": "#/$defs/output"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "cloud_reauthorization": {"$ref": "#/$defs/cloudReauthorization"},
    "upload_pack": {"$ref": "#/$defs/relativePath"},
    "upload_inventory": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/uploadItem"}},
    "upload_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "provider_provenance": {"const": "unattested-user-operated-web"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512},
    "directChild": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/:\\\\]*[^/:\\\\. ]$"},
    "output": {"type": "object", "additionalProperties": false, "required": ["id", "width", "height"], "properties": {"id": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 2}, "height": {"type": "integer", "minimum": 2}}},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["motion_mode", "audio_mode", "lip_sync_required", "voice_authorization_required", "clone_authorized_voice_supported"], "properties": {"motion_mode": {"enum": ["pose-transfer", "video-to-video"]}, "audio_mode": {"enum": ["mute", "preserve-reference"]}, "lip_sync_required": {"const": false}, "voice_authorization_required": {"const": false}, "clone_authorized_voice_supported": {"const": false}}},
    "cloudReauthorization": {"type": "object", "additionalProperties": false, "required": ["scope", "supersedes_manifest_local_only_for_this_upload_only", "character_authorization_sha256", "motion_authorization_sha256"], "properties": {"scope": {"const": "single-user-operated-higgsfield-upload"}, "supersedes_manifest_local_only_for_this_upload_only": {"const": true}, "character_authorization_sha256": {"$ref": "#/$defs/sha256"}, "motion_authorization_sha256": {"$ref": "#/$defs/sha256"}}},
    "uploadItem": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256", "media_type", "size_bytes"], "properties": {"role": {"enum": ["character-image", "motion-video"]}, "path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"enum": ["image/png", "video/mp4"]}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456}}}
  }
}
