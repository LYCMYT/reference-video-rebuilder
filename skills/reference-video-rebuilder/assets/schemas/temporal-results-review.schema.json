{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/temporal-results-review.schema.json",
  "title": "Temporal Results Review",
  "description": "Human review required after complete local technical checks. Metrics cannot establish semantic motion/action reproduction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_sha256", "decision", "comparison_contact_sheet_reviewed", "technical_sanity_reviewed", "full_playback_reviewed", "motion_action_confirmed", "face_hands_limbs_confirmed", "garment_product_confirmed", "timing_confirmed", "audio_confirmed", "rights_confirmed", "watermark_absent_confirmed", "voice_authorization_required", "voice_likeness_confirmed", "lip_sync_required", "lip_sync_confirmed"],
  "properties": {
    "schema_version": {"const": "0.10.0"}, "proposal_sha256": {"$ref": "#/$defs/sha256"}, "decision": {"enum": ["pending", "approved", "rejected"]},
    "comparison_contact_sheet_reviewed": {"type": "boolean"}, "technical_sanity_reviewed": {"type": "boolean"}, "full_playback_reviewed": {"type": "boolean"}, "motion_action_confirmed": {"type": "boolean"}, "face_hands_limbs_confirmed": {"type": "boolean"}, "garment_product_confirmed": {"type": "boolean"}, "timing_confirmed": {"type": "boolean"}, "audio_confirmed": {"type": "boolean"}, "rights_confirmed": {"type": "boolean"}, "watermark_absent_confirmed": {"type": "boolean"}, "voice_authorization_required": {"type": "boolean"}, "voice_likeness_confirmed": {"type": "boolean"}, "lip_sync_required": {"type": "boolean"}, "lip_sync_confirmed": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "approved"}}, "required": ["decision"]}, "then": {"properties": {"comparison_contact_sheet_reviewed": {"const": true}, "technical_sanity_reviewed": {"const": true}, "full_playback_reviewed": {"const": true}, "motion_action_confirmed": {"const": true}, "face_hands_limbs_confirmed": {"const": true}, "garment_product_confirmed": {"const": true}, "timing_confirmed": {"const": true}, "audio_confirmed": {"const": true}, "rights_confirmed": {"const": true}, "watermark_absent_confirmed": {"const": true}}}},
    {"if": {"properties": {"decision": {"const": "approved"}, "voice_authorization_required": {"const": true}}, "required": ["decision", "voice_authorization_required"]}, "then": {"properties": {"voice_likeness_confirmed": {"const": true}}}},
    {"if": {"properties": {"decision": {"const": "approved"}, "lip_sync_required": {"const": true}}, "required": ["decision", "lip_sync_required"]}, "then": {"properties": {"lip_sync_confirmed": {"const": true}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
