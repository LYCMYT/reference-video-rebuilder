{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/temporal-replacement-plan.schema.json",
  "title": "Temporal Replacement Plan",
  "description": "A reviewed local plan. It binds private request data and an action-reference snapshot without copying source filenames or instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "privacy_profile", "cloud_upload_confirmed", "execution_profile", "adapter_id", "adapter_version", "temporal_rights_confirmed", "review_required", "template_path", "template_sha256", "template_id", "manifest_path", "manifest_sha256", "manifest_schema_version", "request_path", "request_sha256", "input_assets", "input_assets_sha256", "reference_pack", "scanner_policy_version", "source_spec", "output", "requirements", "requirements_sha256", "reference_inventory", "reference_inventory_sha256", "evidence"],
  "properties": {
    "schema_version": {"const": "0.10.0"},
    "privacy_profile": {"const": "local-only"},
    "cloud_upload_confirmed": {"const": false},
    "execution_profile": {"const": "local-file-drop"},
    "adapter_id": {"$ref": "#/$defs/adapterId"},
    "adapter_version": {"$ref": "#/$defs/adapterVersion"},
    "temporal_rights_confirmed": {"const": true},
    "review_required": {"const": true},
    "template_path": {"$ref": "#/$defs/relativePath"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "template_id": {"$ref": "#/$defs/id"},
    "manifest_path": {"$ref": "#/$defs/relativePath"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_schema_version": {"const": "0.2.0"},
    "request_path": {"$ref": "#/$defs/relativePath"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_assets": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/inputAsset"}},
    "input_assets_sha256": {"$ref": "#/$defs/sha256"},
    "reference_pack": {"$ref": "#/$defs/directChildName"},
    "scanner_policy_version": {"const": "0.5.0"},
    "source_spec": {"$ref": "#/$defs/sourceSpec"},
    "output": {"$ref": "#/$defs/outputSpec"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "reference_inventory": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/inventoryEntry"}},
    "reference_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["input_contact_sheet"], "properties": {"input_contact_sheet": {"$ref": "#/$defs/artifact"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512},
    "directChildName": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/:\\\\]*[^/:\\\\. ]$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "adapterId": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "adapterVersion": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "sourceSpec": {"type": "object", "additionalProperties": false, "required": ["width", "height", "fps", "frame_count"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "exclusiveMinimum": 0}, "frame_count": {"type": "integer", "minimum": 1}}},
    "outputSpec": {"type": "object", "additionalProperties": false, "required": ["id", "width", "height"], "properties": {"id": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 2}, "height": {"type": "integer", "minimum": 2}}},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["motion_mode", "audio_mode", "lip_sync_required", "voice_likeness_rights_confirmed", "voice_authorization_required", "voice_authorization_sha256", "capability_declarations"], "properties": {"motion_mode": {"enum": ["pose-transfer", "video-to-video"]}, "audio_mode": {"enum": ["mute", "preserve-reference", "replace-upload", "rebuild-sfx", "clone-authorized-voice"]}, "lip_sync_required": {"type": "boolean"}, "voice_likeness_rights_confirmed": {"type": "boolean"}, "voice_authorization_required": {"type": "boolean"}, "voice_authorization_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "capability_declarations": {"type": "object", "additionalProperties": false, "required": ["motion_supported", "audio_supported", "lip_sync_supported", "clone_authorized_voice_supported"], "properties": {"motion_supported": {"const": true}, "audio_supported": {"const": true}, "lip_sync_supported": {"type": "boolean"}, "clone_authorized_voice_supported": {"type": "boolean"}}}}},
    "inputAsset": {"type": "object", "additionalProperties": false, "required": ["slot_id", "sha256", "media_type"], "properties": {"slot_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"enum": ["image/jpeg", "image/png", "image/webp", "video/mp4", "video/quicktime", "video/webm", "audio/wav", "audio/mpeg", "audio/mp4", "audio/x-matroska"]}}},
    "mediaFacts": {"type": "object", "additionalProperties": false, "required": ["container", "width", "height", "fps", "frame_count", "duration_seconds", "cfr", "video_codec", "video_profile", "pixel_format", "bit_depth", "has_audio", "audio_stream_count", "audio_codec", "audio_profile", "audio_sample_rate", "audio_channels", "audio_channel_layout", "rotation_degrees"], "properties": {"container": {"const": "mp4"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "exclusiveMinimum": 0}, "frame_count": {"type": "integer", "minimum": 1}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}, "cfr": {"const": true}, "video_codec": {"const": "h264"}, "video_profile": {"const": "High"}, "pixel_format": {"const": "yuv420p"}, "bit_depth": {"const": 8}, "has_audio": {"type": "boolean"}, "audio_stream_count": {"enum": [0, 1]}, "audio_codec": {"type": ["string", "null"]}, "audio_profile": {"type": ["string", "null"]}, "audio_sample_rate": {"type": ["integer", "null"]}, "audio_channels": {"type": ["integer", "null"]}, "audio_channel_layout": {"type": ["string", "null"]}, "rotation_degrees": {"const": 0}}, "allOf": [{"if": {"properties": {"has_audio": {"const": true}}, "required": ["has_audio"]}, "then": {"properties": {"audio_stream_count": {"const": 1}, "audio_codec": {"const": "aac"}, "audio_profile": {"const": "LC"}, "audio_sample_rate": {"const": 48000}, "audio_channels": {"const": 2}, "audio_channel_layout": {"const": "stereo"}}}}, {"if": {"properties": {"has_audio": {"const": false}}, "required": ["has_audio"]}, "then": {"properties": {"audio_stream_count": {"const": 0}, "audio_codec": {"const": null}, "audio_profile": {"const": null}, "audio_sample_rate": {"const": null}, "audio_channels": {"const": null}, "audio_channel_layout": {"const": null}}}}]},
    "inventoryEntry": {"type": "object", "additionalProperties": false, "required": ["asset_id", "sha256", "size_bytes", "media_type", "facts"], "properties": {"asset_id": {"const": "action-reference.0001"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456}, "media_type": {"const": "video/mp4"}, "facts": {"$ref": "#/$defs/mediaFacts"}}}
  }
}
