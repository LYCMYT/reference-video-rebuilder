{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reference-video-rebuilder/template-ir.schema.json",
  "title": "Reference Video Template IR executable renderer contract",
  "description": "Structural contract for legacy Template IR 0.2.0 and rebuild-declared Template IR 0.3.0. Cross-field timeline and reference checks are performed by video_remix.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "coordinate_space",
    "canvas",
    "source",
    "support",
    "tracks",
    "slots",
    "layers",
    "remove_layers",
    "events",
    "audio",
    "outputs"
  ],
  "properties": {
    "schema_version": {"enum": ["0.2.0", "0.3.0"]},
    "template_id": {"$ref": "#/$defs/id"},
    "coordinate_space": {"const": "canvas-pixels"},
    "canvas": {"$ref": "#/$defs/canvas"},
    "source": {"$ref": "#/$defs/source"},
    "support": {"$ref": "#/$defs/support"},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/track"}
    },
    "slots": {
      "type": "array",
      "items": {"$ref": "#/$defs/slot"}
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/layer"}
    },
    "remove_layers": {
      "type": "array",
      "items": {"$ref": "#/$defs/removeLayer"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    },
    "audio": {"$ref": "#/$defs/audio"},
    "rebuild_requirements": {"$ref": "#/$defs/rebuildRequirements"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "0.2.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "not": {"required": ["rebuild_requirements"]}
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "0.3.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["rebuild_requirements"]
      }
    }
  ],
  "$defs": {
    "rebuildRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_required",
        "motion_mode",
        "audio_mode",
        "lip_sync_required",
        "voice_likeness_rights_confirmed"
      ],
      "properties": {
        "motion_required": {"type": "boolean"},
        "motion_mode": {
          "enum": ["static", "layout-only", "pose-transfer", "video-to-video"]
        },
        "audio_mode": {
          "enum": [
            "mute",
            "preserve-reference",
            "replace-upload",
            "rebuild-sfx",
            "clone-authorized-voice"
          ]
        },
        "lip_sync_required": {"type": "boolean"},
        "voice_likeness_rights_confirmed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"motion_required": {"const": true}},
            "required": ["motion_required"]
          },
          "then": {
            "properties": {
              "motion_mode": {"enum": ["pose-transfer", "video-to-video"]}
            }
          },
          "else": {
            "properties": {
              "motion_mode": {"enum": ["static", "layout-only"]}
            }
          }
        },
        {
          "if": {
            "properties": {"lip_sync_required": {"const": true}},
            "required": ["lip_sync_required"]
          },
          "then": {
            "properties": {
              "motion_required": {"const": true},
              "audio_mode": {"not": {"const": "mute"}}
            }
          }
        },
        {
          "if": {
            "properties": {"audio_mode": {"const": "clone-authorized-voice"}},
            "required": ["audio_mode"]
          },
          "then": {
            "properties": {
              "voice_likeness_rights_confirmed": {"const": true}
            }
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "mediaType": {
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "video/mp4",
        "video/quicktime",
        "video/webm",
        "audio/wav",
        "audio/mpeg",
        "audio/mp4",
        "audio/x-matroska"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
    },
    "frame": {
      "type": "integer",
      "minimum": 0
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame"],
      "properties": {
        "start_frame": {"$ref": "#/$defs/frame"},
        "end_frame": {"type": "integer", "minimum": 1}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "objectPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "pixelRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background", "source_rect"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "background": {"$ref": "#/$defs/color"},
        "source_rect": {"$ref": "#/$defs/pixelRect"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_frames", "fps", "width", "height", "source_sha256"],
      "properties": {
        "duration_frames": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence", "warnings"],
      "properties": {
        "level": {"enum": ["S1", "S2", "S3", "S4"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_required": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "z_index", "overlap_policy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {
          "enum": [
            "background",
            "subject",
            "garment",
            "product",
            "carousel",
            "prop",
            "text",
            "logo",
            "effect"
          ]
        },
        "z_index": {"type": "integer"},
        "overlap_policy": {"enum": ["forbid", "allow"]},
        "group_layout": {"$ref": "#/$defs/carouselLayout"},
        "group_transform": {"$ref": "#/$defs/transform"},
        "clip_mask": {"$ref": "#/$defs/maskShape"}
      },
      "allOf": [
        {
          "if": {"required": ["group_layout"]},
          "then": {
            "required": ["group_transform", "clip_mask"],
            "properties": {"type": {"const": "carousel"}}
          }
        }
      ]
    },
    "carouselLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "origin",
        "item_slots",
        "item_width",
        "item_height",
        "gap",
        "direction",
        "repeat"
      ],
      "properties": {
        "type": {"const": "carousel"},
        "origin": {"$ref": "#/$defs/point"},
        "item_slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "item_width": {"type": "number", "exclusiveMinimum": 0},
        "item_height": {"type": "number", "exclusiveMinimum": 0},
        "gap": {"type": "number", "minimum": 0},
        "direction": {"enum": ["horizontal", "vertical"]},
        "repeat": {"enum": ["none", "loop", "mirror"]}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "required", "accepted_media"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "accepted_media": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/mediaType"}
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "representation"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "representation": {"enum": ["raw", "render-ready"]}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["box", "fit", "object_position"],
      "properties": {
        "box": {"$ref": "#/$defs/rect"},
        "fit": {"enum": ["contain", "cover", "stretch"]},
        "object_position": {"$ref": "#/$defs/objectPosition"}
      }
    },
    "easing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "hold"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "linear"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "control_points"],
          "properties": {
            "type": {"const": "cubic-bezier"},
            "control_points": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number"},
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number"}
              ],
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "translate_x", "translate_y", "scale_x", "scale_y", "rotation_deg", "opacity", "easing"],
      "properties": {
        "frame": {"$ref": "#/$defs/frame"},
        "translate_x": {"type": "number"},
        "translate_y": {"type": "number"},
        "scale_x": {"type": "number", "exclusiveMinimum": 0},
        "scale_y": {"type": "number", "exclusiveMinimum": 0},
        "rotation_deg": {"type": "number"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "easing": {"$ref": "#/$defs/easing"}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "keyframes"],
      "properties": {
        "anchor": {"$ref": "#/$defs/point"},
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/keyframe"}
        }
      }
    },
    "maskShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "rect", "feather_px", "invert"],
          "properties": {
            "type": {"const": "rect"},
            "space": {"enum": ["canvas", "layer"]},
            "rect": {"$ref": "#/$defs/rect"},
            "feather_px": {"type": "number", "minimum": 0},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "rect", "corner_radius_px", "feather_px", "invert"],
          "properties": {
            "type": {"const": "rounded-rect"},
            "space": {"enum": ["canvas", "layer"]},
            "rect": {"$ref": "#/$defs/rect"},
            "corner_radius_px": {"type": "number", "minimum": 0},
            "feather_px": {"type": "number", "minimum": 0},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "points", "feather_px", "invert"],
          "properties": {
            "type": {"const": "polygon"},
            "space": {"enum": ["canvas", "layer"]},
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {"$ref": "#/$defs/point"}
            },
            "feather_px": {"type": "number", "minimum": 0},
            "invert": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "slot_id", "mode", "feather_px", "invert"],
          "properties": {
            "type": {"const": "alpha-asset"},
            "space": {"enum": ["canvas", "layer"]},
            "slot_id": {"$ref": "#/$defs/id"},
            "mode": {"enum": ["alpha", "luma"]},
            "feather_px": {"type": "number", "minimum": 0},
            "invert": {"type": "boolean"}
          }
        }
      ]
    },
    "mask": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/maskShape"}
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "track_id",
        "source",
        "active_ranges",
        "layout",
        "transform",
        "mask",
        "blend",
        "z_offset"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "track_id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/sourceRef"},
        "active_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/frameRange"}
        },
        "layout": {"$ref": "#/$defs/layout"},
        "transform": {"$ref": "#/$defs/transform"},
        "mask": {"$ref": "#/$defs/mask"},
        "blend": {"$ref": "#/$defs/blend"},
        "z_offset": {"type": "integer"}
      }
    },
    "blend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "opacity"],
      "properties": {
        "mode": {"enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten"]},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "sourceShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "rect"],
          "properties": {
            "type": {"const": "rect"},
            "space": {"const": "source"},
            "rect": {"$ref": "#/$defs/rect"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "rect", "corner_radius_px"],
          "properties": {
            "type": {"const": "rounded-rect"},
            "space": {"const": "source"},
            "rect": {"$ref": "#/$defs/rect"},
            "corner_radius_px": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "points"],
          "properties": {
            "type": {"const": "polygon"},
            "space": {"const": "source"},
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {"$ref": "#/$defs/point"}
            }
          }
        }
      ]
    },
    "removeRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_range", "operation", "geometry"],
      "properties": {
        "active_range": {"$ref": "#/$defs/frameRange"},
        "operation": {"enum": ["remove", "keep"]},
        "geometry": {"$ref": "#/$defs/sourceShape"}
      }
    },
    "removeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "policy", "regions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "policy": {
          "enum": [
            "exclude-from-reconstruction",
            "mask-and-rebuild",
            "crop-source-before-analysis"
          ]
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/removeRegion"}
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame", "type", "track_id", "slot_id", "transition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "frame": {"$ref": "#/$defs/frame"},
        "type": {"const": "slot-switch"},
        "track_id": {"$ref": "#/$defs/id"},
        "slot_id": {"$ref": "#/$defs/id"},
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "duration_frames"],
          "properties": {
            "type": {"const": "cut"},
            "duration_frames": {"const": 0}
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "timeline_start_frame",
        "timeline_end_frame",
        "source_in_ms",
        "source_out_ms",
        "playback_rate",
        "loop",
        "gain_db",
        "fade_in_frames",
        "fade_out_frames"
      ],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "timeline_start_frame": {"$ref": "#/$defs/frame"},
        "timeline_end_frame": {"type": "integer", "minimum": 1},
        "source_in_ms": {"type": "number", "minimum": 0},
        "source_out_ms": {"type": "number", "exclusiveMinimum": 0},
        "playback_rate": {"type": "number", "exclusiveMinimum": 0},
        "loop": {"type": "boolean"},
        "gain_db": {"type": "number"},
        "fade_in_frames": {"type": "integer", "minimum": 0},
        "fade_out_frames": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "codec", "pixel_format", "audio_codec", "filename", "reframe"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 2, "multipleOf": 2},
        "codec": {"enum": ["h264", "hevc"]},
        "pixel_format": {"enum": ["yuv420p", "yuv420p10le"]},
        "audio_codec": {"enum": ["aac", "opus"]},
        "filename": {"type": "string", "minLength": 1},
        "reframe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "object_position", "background"],
          "properties": {
            "mode": {"enum": ["contain", "cover", "stretch"]},
            "object_position": {"$ref": "#/$defs/objectPosition"},
            "background": {"$ref": "#/$defs/color"}
          }
        }
      }
    }
  }
}
